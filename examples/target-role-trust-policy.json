{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPipelineRoleWithExternalId",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::111111111111:role/yefter-cicd-pipeline"
        ]
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "EXAMPLE-ONLY-not-a-real-external-id-0000"
        }
      }
    }
  ]
}
