# Copy to backend.tf and replace the placeholders, then run: terraform init -migrate-state
# Uses S3 native locking (use_lockfile), so no DynamoDB table is needed.
terraform {
  backend "s3" {
    bucket       = "REPLACE-with-your-state-bucket"
    key          = "REPLACE-with-a-path/terraform.tfstate"
    region       = "REPLACE-with-your-region"
    encrypt      = true
    use_lockfile = true
  }
}
